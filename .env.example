# Copy this file to .env (which is NOT committed) and put your own values in it:
#   Copy-Item .env.example .env
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Secret used to sign the JWT tokens. Use a long random value.
SECRET_KEY=replace-me-with-a-long-random-string

# Access token lifetime in seconds (300 = 5 min). Use 30 for the expiry demo.
ACCESS_TOKEN_EXPIRES_SECONDS=300
